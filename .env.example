# Obtain a key at https://aistudio.google.com/apikey (use a project without billing).
GEMINI_API_KEY=
# Override if this model is unavailable to your account or free-tier quota.
GEMINI_MODEL=gemini-3.5-flash-lite
AGENT_OUTPUT_DIR=outputs
AGENT_TIMEOUT_SECONDS=240
LLM_TIMEOUT_SECONDS=45
# Conservative spacing between model calls for low free-tier requests-per-minute quotas.
LLM_MIN_INTERVAL_SECONDS=13
